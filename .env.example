# Copy these into Replit Secrets (Tools -> Secrets). Never commit a real .env.

# Required. Must be an IT-issued Gemini key from the standard issuance process
# (naming: gemini-<username>-<team>) — not a personal key. See docs/ARCHITECTURE.md.
GEMINI_API_KEY=

# Set automatically by Replit when you create a PostgreSQL database.
# Locally, leave unset to fall back to a SQLite file (poc.db).
DATABASE_URL=

# Optional overrides.
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini
# KB_PATH=knowledge/kb.md
