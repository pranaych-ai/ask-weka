modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: Ask WEKA"

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
GEMINI_MODEL = "gemini-3.6-flash"
OKTA_ADMIN_USERS = "pranay.chandur@weka.io"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-5000}"]
build = ["bash", "-c", "cd frontend && npm ci --no-audit --no-fund && npm run build"]
